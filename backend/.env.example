# --- Environment selector -------------------------------------------------
# dev  : every service is served from the in-repo mock layer (fully offline).
# prod : every service hits the real free data sources, with NO fallback —
#        a source failure surfaces as a 502 error (never fake market data).
APP_ENV=dev

# --- CORS (H5 build / Taro dev server) ------------------------------------
CORS_ORIGINS=http://localhost:10086,http://127.0.0.1:10086

# --- Real data sources (only used when APP_ENV=prod) ----------------------
FUNDGZ_BASE=https://fundgz.1234567.com.cn/js
SINA_HQ_BASE=https://hq.sinajs.cn
HTTP_TIMEOUT=8

# --- LLM for 投喂分析 (DeepSeek / 通义 / Kimi, OpenAI-compatible) ----------
# Required in prod for /api/analyze and the prod briefing summary.
LLM_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
